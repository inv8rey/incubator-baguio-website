# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard).
# Run supabase/schema.sql in the Supabase SQL editor first.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed if the site is served from a subdirectory instead of a domain
# root (see next.config.js). Leave unset for a normal deployment.
NEXT_PUBLIC_BASE_PATH=

# PostHog project API key + host (Project Settings > Project API key in PostHog).
# This public key can only send pageview events in, not read them back out —
# it's what every page load uses and is safe to expose to the browser.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# A second, separate PostHog credential (unlike the pair above, these two are
# server-only) that CAN read analytics back out, powering the admin
# dashboard's traffic panel. Create a Personal API Key under Settings >
# Personal API Keys; the project ID is under Project Settings > General.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Canonical production URL used for sitemap/canonical/OG tags. Falls back to
# Vercel's own NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL, then to a hardcoded
# default, if unset — see app/seo.ts. Only needs setting explicitly if the
# site is on a custom domain Vercel doesn't already know about.
NEXT_PUBLIC_SITE_URL=

# Verification meta tag for Google Search Console (Settings > Ownership
# verification > HTML tag, just the content value, not the whole tag).
GOOGLE_SITE_VERIFICATION=

# Bypasses Row Level Security entirely — treat like root database access.
# Used only by the daily AI-insights cron job (lib/aiInsightsGenerator.ts),
# which has no user session to authenticate with otherwise. Project Settings
# > API > service_role in the Supabase dashboard. Never expose this to the
# client, never commit it, rotate immediately if it's ever pasted anywhere
# outside a secrets manager (a chat transcript included).
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Workers AI (Account Home > right sidebar for Account ID;
# My Profile > API Tokens for a token with Workers AI edit access).
# Server-side only — never expose these with a NEXT_PUBLIC_ prefix.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Total chatbot answers allowed per UTC day across ALL visitors, so one person
# can't spend the whole Workers AI allowance. The free tier is 10,000
# neurons/day and each answer costs roughly 110-160, so the account runs dry
# near 65-90 questions; 60 leaves headroom. Raise this after moving to a paid
# Workers AI plan. Defaults to 60 when unset.
CHAT_DAILY_BUDGET=60

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# when it hits /api/ai-insights/cron on its daily 7:30am schedule (see
# vercel.json). Generate any random string, e.g. `openssl rand -hex 24`.
CRON_SECRET=

# The admin panel's URL, e.g. https://site.com/<this value>/ — not "/admin".
# Server-only, never sent to the browser. Generate with
# `echo "ib-$(openssl rand -hex 6)"` and bookmark the result; there is no
# link to it anywhere on the public site. Leaving this unset makes the
# admin panel completely unreachable (fails closed), so it must be set in
# every environment that needs admin access, including local dev.
ADMIN_ROUTE_SLUG=

# Sends the organiser a confirmation email when their submitted event is
# approved (lib/sendEventApprovalEmail.ts). Get a key from resend.com;
# EVENTS_EMAIL_FROM must be a domain you've verified with Resend, otherwise
# it falls back to Resend's own onboarding@resend.dev sender. Missing this
# key doesn't break anything — the approval itself still succeeds, the email
# is just silently skipped (the admin UI reports whether it sent).
RESEND_API_KEY=
EVENTS_EMAIL_FROM=

# One-way mirror: every admin edit to Startups/Programs/Events also gets
# pushed out to a Google Sheet (Sheet never writes back into the site).
# Set up a Google Cloud service account with the Sheets API enabled, share
# the target spreadsheet with the service account's email as Editor, and
# create 3 tabs named exactly "Startups", "Programs", "Events".
# Server-side only — never expose these with a NEXT_PUBLIC_ prefix.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
